{
  "id": "eidolonunchained:overworld_deity",
  "name": "Gaia, Mother of All Worlds",
  "description": "Ancient deity of life, growth, and natural cycles",
  "colors": {
    "red": 102,
    "green": 204,
    "blue": 102
  },
  "progression": {
    "max_reputation": 100,
    "stages": [
      {
        "id": "nature_child",
        "reputation": 0,
        "major": false,
        "title": "Child of Nature",
        "description": "One blessed by the world's heartbeat",
        "rewards": [
          "give @s minecraft:wheat_seeds 8",
          "give @s minecraft:apple 3",
          "effect give @s minecraft:regeneration 300 0",
          "title @s title {\"text\":\"Nature's child awakens...\",\"color\":\"green\"}",
          "playsound minecraft:block.grass.step master @s ~ ~ ~ 0.3 1.2"
        ]
      },
      {
        "id": "world_tender",
        "reputation": 25,
        "major": false,
        "title": "World Tender",
        "description": "Caretaker of growing things",
        "rewards": [
          "give @s minecraft:golden_apple 1",
          "give @s minecraft:honey_bottle 3",
          "give @s minecraft:sweet_berries 8",
          "effect give @s minecraft:saturation 60 0",
          "effect give @s minecraft:regeneration 600 0",
          "title @s title {\"text\":\"World Tender\",\"color\":\"green\"}",
          "playsound minecraft:block.beehive.work master @s ~ ~ ~ 0.5 1.0"
        ]
      },
      {
        "id": "life_guardian",
        "reputation": 50,
        "major": true,
        "title": "Guardian of Life",
        "description": "Protector of all living things",
        "rewards": [
          "give @s minecraft:enchanted_golden_apple 1",
          "give @s minecraft:totem_of_undying 1",
          "give @s minecraft:beacon 1",
          "effect give @s minecraft:absorption 1800 2",
          "effect give @s minecraft:regeneration 1800 1",
          "effect give @s minecraft:saturation 300 1",
          "title @s title {\"text\":\"Guardian of Life\",\"color\":\"green\"}",
          "title @s subtitle {\"text\":\"The world's life force flows through you\",\"color\":\"dark_green\"}",
          "playsound minecraft:ui.toast.challenge_complete master @s ~ ~ ~ 1.0 1.1",
          "say A new Guardian of Life emerges to protect the world!"
        ]
      },
      {
        "id": "world_keeper",
        "reputation": 75,
        "major": true,
        "title": "Keeper of the World",
        "description": "Master of natural harmony",
        "rewards": [
          "give @s minecraft:amethyst_shard 5",
          "give @s minecraft:glow_berries 16",
          "give @s minecraft:echo_shard 2",
          "effect give @s minecraft:health_boost 3600 3",
          "effect give @s minecraft:regeneration 3600 2",
          "effect give @s minecraft:resistance 3600 1",
          "effect give @s minecraft:saturation 600 1",
          "title @s title {\"text\":\"Keeper of the World\",\"color\":\"green\"}",
          "title @s subtitle {\"text\":\"All life resonates with your harmony\",\"color\":\"aqua\"}",
          "playsound minecraft:entity.player.levelup master @s ~ ~ ~ 1.0 1.3",
          "say The world itself acknowledges its new Keeper!"
        ]
      },
      {
        "id": "world_sovereign",
        "reputation": 100,
        "major": true,
        "title": "Sovereign of All Worlds",
        "description": "Ultimate embodiment of life itself",
        "rewards": [
          "give @s minecraft:netherite_block 3",
          "give @s minecraft:beacon 2",
          "give @s minecraft:dragon_egg 1",
          "effect give @s minecraft:health_boost 7200 5",
          "effect give @s minecraft:regeneration 7200 3",
          "effect give @s minecraft:resistance 7200 3",
          "effect give @s minecraft:absorption 7200 3",
          "effect give @s minecraft:saturation 1200 2",
          "title @s title {\"text\":\"Sovereign of All Worlds\",\"color\":\"green\",\"bold\":true}",
          "title @s subtitle {\"text\":\"Life itself flows at your command\",\"color\":\"gold\"}",
          "playsound minecraft:ui.toast.challenge_complete master @a ~ ~ ~ 2.0 1.5",
          "say BEHOLD! The Sovereign of All Worlds ascends! Life itself celebrates their reign!"
        ]
      }
    ]
  },
  "abandon": {
    "reputation_penalty": 0.75,
    "reset_reputation": false,
    "message": "§aThe world's heartbeat grows distant from your soul. §7Gaia's nurturing warmth fades, but the path of life remains open to those who cherish growth."
  },
  "prayer_types": ["conversation", "blessing", "growth", "harmony"]
}