          "effect give @s minecraft:absorption 1800 2",
          "effect give @s minecraft:strength 1800 1",
          "effect give @s minecraft:fire_resistance 3600 0",
          "title @s title {\"text\":\"Champion of Hellfire\",\"color\":\"red\"}",
          "title @s subtitle {\"text\":\"The forge-fire bows to your mastery\",\"color\":\"gold\"}",
          "playsound minecraft:ui.toast.challenge_complete master @s ~ ~ ~ 1.0 0.8",
          "say A new Champion of Hellfire rises from the sacred forge!"
        ]
      },
      {
        "id": "lord_of_the_inferno",
        "reputation": 75,
        "major": true,
        "title": "Lord of the Inferno",
        "description": "Commander of all forge-fires",
        "rewards": [
          "give @s minecraft:netherite_ingot 3",
          "give @s minecraft:ancient_debris 2",
          "give @s minecraft:totem_of_undying 1",
          "effect give @s minecraft:health_boost 3600 3",
          "effect give @s minecraft:strength 3600 2",
          "effect give @s minecraft:haste 3600 2",
          "effect give @s minecraft:fire_resistance 7200 0",
          "title @s title {\"text\":\"Lord of the Inferno\",\"color\":\"red\"}",
          "title @s subtitle {\"text\":\"All forge-fires serve your will\",\"color\":\"dark_red\"}",
          "playsound minecraft:entity.player.levelup master @s ~ ~ ~ 1.0 1.2",
          "say The eternal forge crowns a new Lord of the Inferno!"
        ]
      },
      {
        "id": "emperor_of_hellfire",
        "reputation": 100,
        "major": true,
        "title": "Emperor of Hellfire",
        "description": "Ultimate master of the eternal forge",
        "rewards": [
          "give @s minecraft:netherite_block 3",
          "give @s minecraft:beacon 2",
          "give @s minecraft:nether_star 1",
          "effect give @s minecraft:health_boost 7200 5",
          "effect give @s minecraft:strength 7200 4",
          "effect give @s minecraft:haste 7200 3",
          "effect give @s minecraft:resistance 7200 3",
          "effect give @s minecraft:fire_resistance 14400 0",
          "title @s title {\"text\":\"Emperor of Hellfire\",\"color\":\"red\",\"bold\":true}",
          "title @s subtitle {\"text\":\"The eternal forge is yours to command\",\"color\":\"gold\"}",
          "playsound minecraft:ui.toast.challenge_complete master @a ~ ~ ~ 2.0 0.6",
          "say BEHOLD! The Emperor of Hellfire ascends! All forge-fires burn at their command!"
        ]
      }
    ]
