    "stages": [
      {
        "id": "flame_touched",
        "reputation": 0,
        "major": false,
        "title": "Flame Touched",
        "description": "One brushed by the forge-fire",
        "rewards": [
          "give @s minecraft:coal 8",
          "effect give @s minecraft:fire_resistance 120 0",
          "title @s title {\"text\":\"The embers stir around you...\",\"color\":\"red\"}",
          "playsound minecraft:entity.blaze.ambient master @s ~ ~ ~ 0.3 1.0"
        ]
      },
      {
        "id": "hellfire_initiate",
        "reputation": 15,
        "major": false,
        "title": "Hellfire Initiate",
        "description": "One tested by the forge-fire",
        "rewards": [
          "give @s minecraft:blaze_rod 2",
          "effect give @s minecraft:fire_resistance 300 0",
          "title @s title {\"text\":\"The forge-fire tests your worth...\",\"color\":\"red\"}",
          "playsound minecraft:entity.blaze.ambient master @s ~ ~ ~ 0.3 0.8"
        ]
      },
      {
        "id": "hellfire_warrior",
        "reputation": 25,
        "major": false,
        "title": "Hellfire Warrior",
        "description": "Fighter forged in sacred flames",
        "rewards": [
          "give @s minecraft:lava_bucket 1",
          "give @s minecraft:fire_charge 4",
          "effect give @s minecraft:strength 600 0",
          "effect give @s minecraft:fire_resistance 1200 0",
          "title @s title {\"text\":\"Hellfire Warrior\",\"color\":\"red\"}",
          "playsound minecraft:entity.blaze.hurt master @s ~ ~ ~ 0.5 1.2"
        ]
      },
      {
        "id": "champion_of_hellfire",
