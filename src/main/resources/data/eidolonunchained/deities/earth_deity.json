          "effect give @s minecraft:resistance 7200 4",
          "effect give @s minecraft:haste 7200 3",
          "effect give @s minecraft:strength 7200 2",
          "title @s title {\"text\":\"Sovereign of All Earth\",\"color\":\"gray\",\"bold\":true}",
          "title @s subtitle {\"text\":\"The world's foundation serves your command\",\"color\":\"gold\"}",
          "playsound minecraft:ui.toast.challenge_complete master @a ~ ~ ~ 2.0 0.7",
          "say BEHOLD! The Sovereign of All Earth ascends! The very ground trembles in reverence!"
