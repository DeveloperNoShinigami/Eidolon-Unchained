        ]
      },
      {
        "id": "mountain_walker",
        "reputation": 25,
        "major": false,
        "title": "Mountain Walker",
        "description": "Traveler of stone paths",
        "rewards": [
          "give @s minecraft:iron_ore 6",
          "give @s minecraft:bone_meal 8",
          "effect give @s minecraft:absorption 600 0",
          "effect give @s minecraft:resistance 600 0",
          "title @s title {\"text\":\"Mountain Walker\",\"color\":\"gray\"}",
          "playsound minecraft:block.anvil.use master @s ~ ~ ~ 0.5 1.0"
        ]
      },
      {
        "id": "stone_guardian",
        "reputation": 50,
        "major": true,
        "title": "Guardian of Stone",
        "description": "Protector of mountain mysteries",
        "rewards": [
          "give @s minecraft:diamond 3",
          "give @s minecraft:emerald 2",
          "give @s minecraft:beacon 1",
          "effect give @s minecraft:absorption 1800 2",
