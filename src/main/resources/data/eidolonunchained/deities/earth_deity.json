          "effect give @s minecraft:resistance 3600 2",
          "effect give @s minecraft:haste 3600 2",
          "title @s title {\"text\":\"Lord of Mountains\",\"color\":\"gray\"}",
          "title @s subtitle {\"text\":\"All stone bends to your ancient will\",\"color\":\"dark_red\"}",
          "playsound minecraft:entity.player.levelup master @s ~ ~ ~ 1.0 0.8",
          "say The eternal mountains crown their new Lord!"
