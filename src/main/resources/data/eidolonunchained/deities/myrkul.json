{
  "id": "eidolonunchained:myrkul",
  "name": "Myrkul, God of Undeath",
  "description": "Sovereign of lingering souls and the cold blue flame. Master of the threshold between life and death.",
  "colors": {
    "red": 64,
    "green": 180,
    "blue": 255
  },
  "progression": {
    "max_reputation": 100,
    "stages": [
      {
        "id": "follower",
        "reputation": 0,
        "major": false,
        "title": "Follower of the Cold Flame",
        "description": "A seeker on the threshold, unbound but listening.",
        "rewards": [
          "title @s title {\"text\":\"The souls take notice...\",\"color\":\"aqua\"}",
          "playsound minecraft:ambient.soul_sand_valley.mood master @s ~ ~ ~ 0.8 1.0"
        ]
      },
      {
        "id": "grave_initiate",
        "reputation": 15,
        "major": false,
        "title": "Grave Initiate",
        "description": "One who has heard the whisper of souls.",
        "rewards": [
          "give @s eidolon:soul_shard 2",
          "effect give @s minecraft:night_vision 900 0",
          "title @s title {\"text\":\"Grave Initiate\",\"color\":\"aqua\"}"
        ]
      },
      {
        "id": "bone_adept",
  "reputation": 25,
        "major": false,
        "title": "Bone Adept",
        "description": "A devotee shaping the will of the dead.",
        "rewards": [
          "give @s eidolon:death_essence 2",
          "give @s minecraft:wither_rose 1",
          "effect give @s minecraft:strength 600 0",
          "title @s title {\"text\":\"Bone Adept\",\"color\":\"aqua\"}"
        ]
      },
      {
        "id": "grave_priest",
  "reputation": 50,
        "major": true,
        "title": "Grave Priest",
        "description": "Keeper of soul-flame and necromantic rite.",
        "rewards": [
          "give @s eidolon:zombie_heart 1",
          "give @s eidolon:lesser_soul_gem 1",
          "effect give @s minecraft:resistance 900 0",
          "title @s title {\"text\":\"Grave Priest\",\"color\":\"aqua\",\"bold\":true}"
        ]
      },
      {
        "id": "lich_master",
  "reputation": 75,
        "major": true,
        "title": "Lich Master",
        "description": "Wielder of profound undeath and soul dominion.",
        "rewards": [
          "give @s eidolon:greater_soul_gem 1",
          "give @s eidolon:arcane_gold_ingot 2",
          "effect give @s minecraft:water_breathing 1200 0",
          "effect give @s minecraft:resistance 1200 1",
          "title @s title {\"text\":\"Lich Master\",\"color\":\"aqua\",\"bold\":true}"
        ]
      },
      {
        "id": "lord_of_undeath",
  "reputation": 100,
        "major": true,
        "title": "Lord of Undeath",
        "description": "Crowned in soul-flame; commander of the dead.",
        "rewards": [
          "give @s eidolon:shadow_gem 1",
          "give @s eidolon:death_essence 5",
          "effect give @s minecraft:strength 1800 1",
          "effect give @s minecraft:resistance 1800 2",
          "title @s title {\"text\":\"LORD OF UNDEATH\",\"color\":\"aqua\",\"bold\":true,\"underlined\":true}",
          "tellraw @a {\"text\":\"❄ A Lord of Undeath rises, crowned in soul flame ❄\",\"color\":\"aqua\",\"bold\":true}"
        ]
      }
    ]
  },
  "abandon": {
    "reputation_penalty": 1.0,
    "reset_reputation": true,
    "message": "§3The soul-flame gutters. §bMyrkul withdraws his favor; your progress is claimed by the cold beyond."
  },
  "prayer_types": ["conversation", "blessing", "knowledge", "curse"]
}
