  "description": "Ancient protector of forests and growing things",
  "colors": {
    "red": 34,
    "green": 139,
    "blue": 34
  },
  "progression": {
    "max_reputation": 100,
    "stages": [
      {
        "id": "nature_initiate",
        "reputation": 0,
        "major": false,
        "title": "Nature Initiate",
        "description": "A soul newly awakened to nature's call",
        "rewards": [
          "give @s minecraft:oak_sapling 4",
          "give @s minecraft:bone_meal 8",
          "effect give @s minecraft:saturation 300 0",
          "title @s title {\"text\":\"Nature Initiate\",\"color\":\"green\"}",
          "playsound minecraft:block.grass.break master @s ~ ~ ~ 0.5 1.2"
        ]
      },
      {
        "id": "nature_acolyte",
        "reputation": 25,
        "major": false,
        "title": "Nature Acolyte",
        "description": "Student of the natural mysteries",
        "rewards": [
          "give @s minecraft:bone_meal 16",
          "give @s eidolon:fungal_sprouts 3",
          "effect give @s minecraft:regeneration 600 1",
          "effect give @s minecraft:luck 1200 0",
          "title @s title {\"text\":\"Nature Acolyte\",\"color\":\"dark_green\"}",
          "playsound minecraft:block.composter.ready master @s ~ ~ ~ 0.7 1.0"
        ]
      },
      {
        "id": "nature_priest",
        "reputation": 50,
        "major": true,
        "title": "Nature Priest",
        "description": "Guardian of the forest's sacred wisdom",
        "rewards": [
          "give @s minecraft:golden_apple 2",
          "give @s eidolon:fungal_sprouts 5",
          "give @s minecraft:emerald 3",
          "effect give @s minecraft:regeneration 1800 2",
          "effect give @s minecraft:luck 2400 1",
          "title @s title {\"text\":\"Nature Priest\",\"color\":\"green\"}",
          "title @s subtitle {\"text\":\"Guardian of forest wisdom\",\"color\":\"dark_green\"}",
          "playsound minecraft:entity.player.levelup master @s ~ ~ ~ 1.0 1.0",
          "say A new Nature Priest! The forest spirits celebrate their dedication."
        ]
      },
      {
        "id": "nature_high_priest",
        "reputation": 75,
        "major": true,
        "title": "High Priest of Growth",
        "description": "Keeper of life's eternal cycle",
        "rewards": [
          "give @s minecraft:enchanted_golden_apple 1",
          "give @s eidolon:arcane_gold_ingot 3",
          "give @s eidolon:nature_staff 1",
          "effect give @s minecraft:regeneration 3600 3",
          "effect give @s minecraft:absorption 3600 2",
          "effect give @s minecraft:luck 3600 2",
          "title @s title {\"text\":\"High Priest of Growth\",\"color\":\"green\"}",
          "title @s subtitle {\"text\":\"Keeper of life's eternal cycle\",\"color\":\"gold\"}",
          "playsound minecraft:block.beacon.power_select master @s ~ ~ ~ 1.0 1.5",
          "say The ancient forests whisper a new name! A High Priest of Growth has risen!"
        ]
      },
      {
        "id": "nature_champion",
        "reputation": 100,
        "major": true,
        "title": "Champion of Verdania",
        "description": "Ultimate protector of all growing things",
        "rewards": [
          "give @s eidolon:enchanted_ash 5",
          "give @s minecraft:enchanted_golden_apple 3",
          "give @s eidolon:greater_soul_gem 1",
          "give @s eidolon:verdant_crown 1",
          "effect give @s minecraft:regeneration 7200 4",
          "effect give @s minecraft:absorption 7200 3",
          "effect give @s minecraft:luck 7200 3",
          "effect give @s minecraft:hero_of_the_village 12000 3",
          "title @s title {\"text\":\"Champion of Verdania\",\"color\":\"green\",\"bold\":true}",
          "title @s subtitle {\"text\":\"Ultimate protector of all life\",\"color\":\"gold\"}",
          "playsound minecraft:ui.toast.challenge_complete master @a ~ ~ ~ 2.0 0.8",
          "say NATURE ITSELF REJOICES! A Champion of Verdania has ascended! All life flourishes in their presence!"
        ]
      }
    ]
