{
  "id": "eidolonunchained:twilight_deity",
  "name": "Umbral, the Twilight Sovereign",
  "description": "Ancient deity who governs the eternal balance between light and darkness",
  "colors": {
    "red": 128,
    "green": 128,
    "blue": 128
  },
  "progression": {
    "max_reputation": 100,
    "stages": [
      {
        "id": "balance_seeker",
        "reputation": 0,
        "major": false,
        "title": "Balance Seeker",
        "description": "One who seeks harmony between light and shadow",
        "rewards": [
          "give @s minecraft:clock 1",
          "give @s minecraft:glowstone_dust 4",
          "give @s minecraft:coal 4",
          "effect give @s minecraft:night_vision 300 0",
          "title @s title {\"text\":\"Balance calls to you...\",\"color\":\"gray\"}",
          "playsound minecraft:block.beacon.activate master @s ~ ~ ~ 0.5 1.1"
        ]
      },
      {
        "id": "twilight_walker",
        "reputation": 25,
        "major": false,
        "title": "Twilight Walker",
        "description": "Walker between light and shadow",
        "rewards": [
          "give @s minecraft:golden_apple 1",
          "give @s minecraft:daylight_detector 1",
          "effect give @s minecraft:invisibility 300 0",
          "effect give @s minecraft:regeneration 600 0",
          "title @s title {\"text\":\"Twilight Walker\",\"color\":\"gray\"}",
          "playsound minecraft:block.portal.ambient master @s ~ ~ ~ 0.5 1.2"
        ]
      },
      {
        "id": "balance_guardian",
        "reputation": 50,
        "major": true,
        "title": "Guardian of Balance",
        "description": "Protector of cosmic equilibrium",
        "rewards": [
          "give @s minecraft:enchanted_golden_apple 1",
          "give @s minecraft:totem_of_undying 1",
          "give @s minecraft:beacon 1",
          "effect give @s minecraft:absorption 1800 2",
          "effect give @s minecraft:night_vision 2400 0",
          "title @s title {\"text\":\"Guardian of Balance\",\"color\":\"gray\"}",
          "title @s subtitle {\"text\":\"The eternal balance acknowledges you\",\"color\":\"white\"}",
          "playsound minecraft:ui.toast.challenge_complete master @s ~ ~ ~ 1.0 0.8",
          "say A new Guardian of Balance emerges from the twilight!"
        ]
      },
      {
        "id": "harmony_keeper",
        "reputation": 75,
        "major": true,
        "title": "Keeper of Harmony",
        "description": "Master of twilight equilibrium",
        "rewards": [
          "give @s minecraft:nether_star 1",
          "give @s minecraft:shulker_box 2",
          "give @s minecraft:elytra 1",
          "effect give @s minecraft:health_boost 3600 3",
          "effect give @s minecraft:absorption 3600 2",
          "effect give @s minecraft:night_vision 3600 0",
          "title @s title {\"text\":\"Keeper of Harmony\",\"color\":\"gray\"}",
          "title @s subtitle {\"text\":\"Balance's mysteries are yours\",\"color\":\"white\"}",
          "playsound minecraft:entity.player.levelup master @s ~ ~ ~ 1.0 1.2",
          "say The cosmic balance bows before its new Keeper!"
        ]
      },
      {
        "id": "equilibrium_sovereign",
        "reputation": 100,
        "major": true,
        "title": "Sovereign of Equilibrium",
        "description": "Ultimate master of cosmic balance",
        "rewards": [
          "give @s minecraft:dragon_egg 1",
          "give @s minecraft:end_crystal 2",
          "give @s minecraft:netherite_block 3",
          "effect give @s minecraft:health_boost 7200 4",
          "effect give @s minecraft:strength 7200 3",
          "effect give @s minecraft:resistance 7200 3",
          "effect give @s minecraft:night_vision 7200 0",
          "title @s title {\"text\":\"Sovereign of Equilibrium\",\"color\":\"gray\",\"bold\":true}",
          "title @s subtitle {\"text\":\"The eternal balance is yours to command\",\"color\":\"white\"}",
          "playsound minecraft:ui.toast.challenge_complete master @a ~ ~ ~ 2.0 0.9",
          "say BEHOLD! The Sovereign of Equilibrium has ascended! Light and shadow bend to their will!"
        ]
      }
    ]
  },
  "abandon": {
    "reputation_penalty": 0.75,
    "reset_reputation": false,
    "message": "§7The balance shifts away from your soul. §8Umbral's guidance fades, but the path to equilibrium remains open to those who seek harmony."
  },
  "prayer_types": ["conversation", "blessing", "guidance", "mystery"]
}