          "give @s minecraft:heart_of_the_sea 1",
          "effect give @s minecraft:absorption 1800 2",
          "effect give @s minecraft:regeneration 1800 1",
          "effect give @s minecraft:water_breathing 3600 0",
          "title @s title {\"text\":\"Guardian of the Depths\",\"color\":\"aqua\"}",
