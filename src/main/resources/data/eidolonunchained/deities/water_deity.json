          "effect give @s minecraft:resistance 3600 1",
          "effect give @s minecraft:water_breathing 7200 0",
          "title @s title {\"text\":\"Master of Tides\",\"color\":\"aqua\"}",
          "title @s subtitle {\"text\":\"All waters flow at your command\",\"color\":\"blue\"}",
          "playsound minecraft:entity.player.levelup master @s ~ ~ ~ 1.0 1.3",
          "say The endless oceans acknowledge their new Tide Master!"
        ]
      },
      {
        "id": "ocean_sovereign",
        "reputation": 100,
        "major": true,
        "title": "Sovereign of All Oceans",
        "description": "Ultimate ruler of the water realm",
        "rewards": [
          "give @s minecraft:beacon 2",
          "give @s minecraft:totem_of_undying 2",
          "give @s minecraft:elytra 1",
          "effect give @s minecraft:health_boost 7200 5",
          "effect give @s minecraft:regeneration 7200 3",
          "effect give @s minecraft:resistance 7200 3",
          "effect give @s minecraft:water_breathing 14400 0",
          "effect give @s minecraft:dolphin_grace 7200 2",
          "title @s title {\"text\":\"Sovereign of All Oceans\",\"color\":\"aqua\",\"bold\":true}",
          "title @s subtitle {\"text\":\"The waters of all worlds serve you\",\"color\":\"gold\"}",
          "playsound minecraft:ui.toast.challenge_complete master @a ~ ~ ~ 2.0 1.5",
          "say BEHOLD! The Sovereign of All Oceans ascends! The seas themselves celebrate!"
