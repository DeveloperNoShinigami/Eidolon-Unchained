        "major": false,
        "title": "Tide Touched",
        "description": "One blessed by the flowing waters",
        "rewards": [
          "give @s minecraft:water_bucket 1",
          "effect give @s minecraft:water_breathing 600 0",
          "title @s title {\"text\":\"The tides whisper your name...\",\"color\":\"aqua\"}",
          "playsound minecraft:ambient.underwater.loop master @s ~ ~ ~ 0.3 1.2"
        ]
      },
      {
        "id": "wave_walker",
        "reputation": 25,
        "major": false,
        "title": "Wave Walker",
        "description": "Traveler of ocean currents",
        "rewards": [
          "give @s minecraft:kelp 8",
          "give @s minecraft:prismarine 4",
          "effect give @s minecraft:regeneration 600 0",
          "effect give @s minecraft:water_breathing 1200 0",
          "title @s title {\"text\":\"Wave Walker\",\"color\":\"aqua\"}",
          "playsound minecraft:entity.dolphin.ambient master @s ~ ~ ~ 0.5 1.0"
        ]
      },
      {
        "id": "depths_guardian",
        "reputation": 50,
        "major": true,
        "title": "Guardian of the Depths",
        "description": "Protector of ocean mysteries",
