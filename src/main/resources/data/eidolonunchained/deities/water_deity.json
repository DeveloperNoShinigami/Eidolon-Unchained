          "playsound minecraft:ui.toast.challenge_complete master @s ~ ~ ~ 1.0 1.1",
          "say A new Guardian of the Depths emerges from the sacred waters!"
        ]
      },
      {
        "id": "tide_master",
        "reputation": 75,
        "major": true,
        "title": "Master of Tides",
