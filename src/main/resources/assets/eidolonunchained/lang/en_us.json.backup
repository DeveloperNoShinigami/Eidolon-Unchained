{
  "_comment_header": "=== EIDOLON UNCHAINED LANGUAGE FILE ===",
  "_comment_structure": "Standardized language keys: eidolonunchained.<system>.<category>.<name>.<type>",
  "_comment_compatibility": "Uses eidolon.codex.* format for Eidolon compatibility",

  "_comment_codex_system": "=== CODEX SYSTEM ===",
  "_comment_codex_note": "Codex entries and pages for integration with Eidolon's codex",
  "eidolon.codex.entry.air_patronage_ritual": "Air Patronage Ritual",
  "eidolon.codex.entry.air_patronage_ritual.description": "A ceremony to gain favor with the elemental powers of air through offerings and devoted practice.",
  "eidolon.codex.entry.air_patronage_ritual.effects": "Grants enhanced mobility, wind-based abilities, and improved aerial navigation.",
  "eidolon.codex.entry.crucible_example.intro": "The Eidolon Crucible can be used to create enhanced magical items through careful alchemical processes.",
  "eidolon.codex.entry.crucible_example.nature_explanation": "Nature Soul Gems are created by infusing natural materials with elemental energies.",
  "eidolon.codex.entry.crucible_example.shadow_explanation": "Enhanced Shadow Gems require careful preparation using dark essence and corrupted materials.",
  "eidolon.codex.entry.crucible_example.title": "Crucible Example",
  "eidolon.codex.entry.deity_rituals_overview": "The three primary deities each offer unique rituals and powers to their faithful followers.",
  "eidolon.codex.entry.deity_rituals_overview.dark": "Nyxathel, Shadow Lord, grants forbidden knowledge, dark magic, and power over shadows.",
  "eidolon.codex.entry.deity_rituals_overview.intro": "The three primary deities each offer unique rituals and powers to their faithful followers.",
  "eidolon.codex.entry.deity_rituals_overview.light": "Lumina, Sacred Guardian, provides divine protection, purification, and holy power.",
  "eidolon.codex.entry.deity_rituals_overview.nature": "Verdania, Guardian of Nature, offers growth, healing, and natural protection.",
  "eidolon.codex.entry.deity_rituals_overview.tasks": "Each deity offers tasks and challenges that grow in complexity as your devotion increases.",
  "eidolon.codex.entry.divine_communion.chant_description": "Draw the signs of Sacred, Harmony, and Warding to call upon divine blessing.",
  "eidolon.codex.entry.divine_communion.description": "Seek guidance from Lumina the Sacred Guardian. This blessed chant allows communication with the deity of light and protection.",
  "eidolon.codex.entry.divine_judgment.chant_description": "Channel the wrath of the divine to strike down evil. Draw the signs of Sacred, Flame, and Death to invoke divine judgment.",
  "eidolon.codex.entry.divine_judgment.description": "A powerful offensive chant that calls upon divine power to destroy the wicked.",
  "eidolon.codex.entry.earth_patronage_ritual": "Earth Patronage Ritual",
  "eidolon.codex.entry.earth_patronage_ritual.description": "A ceremony to gain favor with the elemental powers of earth through stone offerings and grounding rituals.",
  "eidolon.codex.entry.earth_patronage_ritual.effects": "Grants enhanced durability, earth manipulation abilities, and improved mining capabilities.",
  "eidolon.codex.entry.end_patronage_ritual": "End Patronage Ritual",
  "eidolon.codex.entry.end_patronage_ritual.description": "A ceremony to gain favor with the void powers of the End through endstone offerings and dimensional rituals.",
  "eidolon.codex.entry.end_patronage_ritual.effects": "Grants teleportation abilities, void resistance, and enhanced End-related crafting.",
  "eidolon.codex.entry.enhanced_shadow_gems.intro": "These powerful gems are infused with shadow magic and can be used to craft advanced items.",
  "eidolon.codex.entry.enhanced_shadow_gems.title": "Enhanced Shadow Gems",
  "eidolon.codex.entry.enhanced_shadow_gems.warning": "Warning: Handling these gems requires careful preparation and protection from corruption.",
  "eidolon.codex.entry.entity_example": "This entry demonstrates how to display entities in the codex.",
  "eidolon.codex.entry.entity_example.description": "This entry demonstrates how to display entities in the codex.",
  "eidolon.codex.entry.fire_patronage_ritual": "Fire Patronage Ritual",
  "eidolon.codex.entry.fire_patronage_ritual.description": "A ceremony to gain favor with the elemental powers of fire through flame offerings and heat-based rituals.",
  "eidolon.codex.entry.fire_patronage_ritual.effects": "Grants fire immunity, flame manipulation abilities, and enhanced smelting capabilities.",
  "eidolon.codex.entry.forbidden_knowledge.chant_description": "Seek out secrets that should remain hidden. Draw the signs of Wicked, Mind, and Magic to access forbidden lore.",
  "eidolon.codex.entry.forbidden_knowledge.description": "A dangerous chant that reveals hidden knowledge at a terrible price.",
  "eidolon.codex.entry.gaias_wrath.chant_description": "Unleash the fury of the earth itself. Draw the signs of Harmony, Flame, and Death to invoke nature's devastating power.",
  "eidolon.codex.entry.gaias_wrath.description": "A destructive chant that channels the earth's anger against those who would harm the natural world.",
  "eidolon.codex.entry.light_patronage_ritual": "A sacred ritual to establish connection with Lumina, the Sacred Guardian.",
  "eidolon.codex.entry.light_patronage_ritual.description": "A sacred ritual to establish connection with Lumina, the Sacred Guardian.",
  "eidolon.codex.entry.light_patronage_ritual.effects": "Successfully completing this ritual grants Light Patronage and allows communion with Lumina.",
  "eidolon.codex.entry.nature_patronage_ritual": "A sacred ritual to establish connection with Verdania, Guardian of Nature.",
  "eidolon.codex.entry.nature_patronage_ritual.description": "A sacred ritual to establish connection with Verdania, Guardian of Nature.",
  "eidolon.codex.entry.nature_patronage_ritual.effects": "Successfully completing this ritual grants Nature Patronage and allows communion with Verdania.",
  "eidolon.codex.entry.natures_communion.chant_description": "Draw the signs of Harmony, Soul, and Sacred to commune with nature's guardian.",
  "eidolon.codex.entry.natures_communion.description": "Connect with Verdania, Guardian of Nature. This chant harmonizes your spirit with the natural world.",
  "eidolon.codex.entry.nether_patronage_ritual": "Nether Patronage Ritual",
  "eidolon.codex.entry.nether_patronage_ritual.description": "A ceremony to gain favor with the infernal powers of the Nether through netherrack offerings and infernal rituals.",
  "eidolon.codex.entry.nether_patronage_ritual.effects": "Grants fire resistance, nether navigation, and enhanced nether-related abilities.",
  "eidolon.codex.entry.overworld_patronage_ritual": "Overworld Patronage Ritual",
  "eidolon.codex.entry.overworld_patronage_ritual.description": "A ceremony to strengthen your connection with the natural world through earth offerings and nature-based rituals.",
  "eidolon.codex.entry.overworld_patronage_ritual.effects": "Grants enhanced natural regeneration, improved crop growth, and animal communication abilities.",
  "eidolon.codex.entry.recipe_example.explanation": "Recipe pages automatically display crafting grids and ingredients.",
  "eidolon.codex.entry.recipe_example.title": "Recipe Example",
